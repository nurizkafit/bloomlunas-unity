  m_text: '<size=22><b>PRODUCTS</b></size>

    <b>Beras kencur</b>  <color=#7A6A50>demand 4-6</color>  <color=#A77A1E>price 4.0</color>  units <b>0</b>  <link="product:beras_kencur:-1"><color=#A33B2E><b>[-]</b></color></link> <link="product:beras_kencur:1"><color=#2F6B4F><b>[+]</b></color></link>

    <b>Kunyit asam</b>  <color=#7A6A50>demand 4-6</color>  <color=#A77A1E>price 5.7</color>  units <b>12</b>  <link="product:kunyit_asam:-1"><color=#A33B2E><b>[-]</b></color></link> <link="product:kunyit_asam:1"><color=#2F6B4F><b>[+]</b></color></link>

    <b>Lemongrass balm</b>  <color=#7A6A50>demand 9-15</color>  <color=#A77A1E>price 13.0</color>  units <b>0</b>  <link="product:lemongrass_balm:-1"><color=#A33B2E><b>[-]</b></color></link> <link="product:lemongrass_balm:1"><color=#2F6B4F><b>[+]</b></color></link>

    <b>Turmeric salep</b>  <color=#7A6A50>demand 10-14</color>  <color=#A77A1E>price 12.0</color>  units <b>0</b>  <link="product:turmeric_salep:-1"><color=#A33B2E><b>[-]</b></color></link> <link="product:turmeric_salep:1"><color=#2F6B4F><b>[+]</b></color></link>



    <size=22><b>BUDGET JARS</b></size>

    <b>Store</b>  100  <link="jar:Store:-5"><color=#A33B2E><b>[-]</b></color></link> <link="jar:Store:5"><color=#2F6B4F><b>[+]</b></color></link>

