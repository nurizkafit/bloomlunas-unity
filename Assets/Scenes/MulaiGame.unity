--- !u!114 &1815158105
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1815158103}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<size=22><b>PRODUCTS</b></size>

    <b>Beras kencur</b>  <color=#7A6A50>demand 4-6</color>  usual 4.0  now <color=#A77A1E>4.0</color>  <color=#A33B2E>v</color>  <link="band:beras_kencur:0"><color=#A33B2E><b>L</b></color></link> <link="band:beras_kencur:1"><color=#7A6A50><b>F</b></color></link> <link="band:beras_kencur:2"><color=#2F6B4F><b>H</b></color></link>

    <b>Kunyit asam</b>  <color=#7A6A50>demand 4.5-6.5</color>  usual 5.7  now <color=#A77A1E>5.7</color>  <color=#2F6B4F>^</color>  <link="band:kunyit_asam:0"><color=#A33B2E><b>L</b></color></link> <link="band:kunyit_asam:1"><color=#7A6A50><b>F</b></color></link> <link="band:kunyit_asam:2"><color=#2F6B4F><b>H</b></color></link>

    <b>Lemongrass balm</b>  <color=#7A6A50>demand 9-15</color>  usual 13.0  now <color=#A77A1E>13.0</color>  <color=#2F6B4F>^</color>  <link="band:lemongrass_balm:0"><color=#A33B2E><b>L</b></color></link> <link="band:lemongrass_balm:1"><color=#7A6A50><b>F</b></color></link> <link="band:lemongrass_balm:2"><color=#2F6B4F><b>H</b></color></link>

    <b>Turmeric salep</b>  <color=#7A6A50>demand 10-14</color>  usual 12.0  now <color=#A77A1E>12.0</color>  <color=#2F6B4F>^</color>  <link="band:turmeric_salep:0"><color=#A33B2E><b>L</b></color></link> <link="band:turmeric_salep:1"><color=#7A6A50><b>F</b></color></link> <link="band:turmeric_salep:2"><color=#2F6B4F><b>H</b></color></link>



    <size=22><b>MATERIALS</b></size>

    Beeswax block  <color=#7A6A50>demand 8-12</color>  now <color=#A77A1E>10.5</color>  <color=#7A6A50>-</color>

    Coconut oil  <color=#7A6A50>demand 5-8</color>  now <color=#A77A1E>7.9</color>  <color=#7A6A50>-</color>

    Ginger fresh  <color=#7A6A50>demand 4-7</color>  now <color=#A77A1E>6.9</color>  <color=#2F6B4F>^</color>

    Kencur fresh  <color=#7A6A50>demand 3-5</color>  now <color=#A77A1E>3.6</color>  <color=#7A6A50>-</color>

    Lemongrass fresh  <color=#7A6A50>demand 2-4</color>  now <color=#A77A1E>2.9</color>  <color=#A33B2E>v</color>

    Palm sugar block  <color=#7A6A50>demand 3-5</color>  now <color=#A77A1E>3.3</color>  <color=#7A6A50>-</color>

    Rice grain  <color=#7A6A50>demand 1-5</color>  now <color=#A77A1E>1.8</color>  <color=#A33B2E>v</color>

    Tamarind paste  <color=#7A6A50>demand 3-5</color>  now <color=#A77A1E>3.5</color>  <color=#7A6A50>-</color>

    Turmeric fresh  <color=#7A6A50>demand 3-5</color>  now <color=#A77A1E>3.3</color>  <color=#2F6B4F>^</color>



    <color=#7A6A50>L = low price, F = fair price, H = high price.</color>

'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 11f0434a02233bb4c96efbb51bf54d73, type: 2}
